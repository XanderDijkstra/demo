# ─── Supabase ────────────────────────────────────────────────────────────────
# Auto-injected by Vercel's Supabase integration on deploy.
# For local dev, copy this file to .env.local and paste your project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cron secret ─────────────────────────────────────────────────────────────
# Vercel auto-generates this on deploy when vercel.json declares crons.
# It's checked in app/api/cron/brreg-daily/route.ts to authenticate
# scheduled invocations.
CRON_SECRET=

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for absolute URLs. Vercel sets this automatically (VERCEL_URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email provider ──────────────────────────────────────────────────────────
# Which backend handles outbound + inbound. Defaults to "resend" if unset.
# Set EMAIL_PROVIDER=postmark to flip every send + webhook to Postmark.
EMAIL_PROVIDER=resend

# ─── Resend (email outreach) ─────────────────────────────────────────────────
# https://resend.com/api-keys
# The FROM address is stored in the `outreach_email_from` setting row
# (editable from /admin/settings). The domain must be verified in Resend
# before sends will succeed.
RESEND_API_KEY=

# Resend webhook signing secret. Created in the Resend dashboard when you
# add a webhook pointing at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# Optional: dedicated signing secret for the unsubscribe-link HMAC.
# Falls back to RESEND_WEBHOOK_SECRET when unset.
UNSUBSCRIBE_SECRET=

# ─── Postmark (alternative provider; full inbound body in webhooks) ─────────
# https://account.postmarkapp.com/servers
# Create a "Server" in Postmark, copy its Server API Token here. Set
# EMAIL_PROVIDER=postmark above to make sends + webhooks route through it.
POSTMARK_SERVER_TOKEN=

# HTTP Basic Auth for the Postmark webhook. Set in Postmark's webhook
# config (Servers → Settings → Webhooks → set username + password) and
# mirrored here so /api/webhooks/postmark accepts the events.
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=

# Postmark separates "transactional" (outbound) vs "broadcast" message
# streams. Cold-outreach goes on "outbound" by default; set this to
# override if you've created a custom stream.
POSTMARK_MESSAGE_STREAM=outbound

# ─── 1881 (Opplysningen 1881 — contact-data enrichment) ─────────────────────
# https://www.api1881.no — sign in, subscribe to the Søkeoppslag product,
# and copy your subscription key here. Used by the "1881-berikelse" job on
# /admin/queue to fill email/phone/contact for leads Brreg left blank
# (including companies with no website).
ONE1881_API_KEY=

# Optional overrides — only set these if the portal docs show a different
# gateway origin / path than the defaults. LOOKUP_PATH must contain the
# {orgnr} placeholder. The subscription header defaults to the Azure APIM
# convention.
# ONE1881_BASE_URL=https://api.api1881.no
# ONE1881_LOOKUP_PATH=/lookup/v1/companies/{orgnr}
# ONE1881_SUBSCRIPTION_HEADER=Ocp-Apim-Subscription-Key

# ─── Freepik / Magnific (stock photos for demo sites) ───────────────────────
# https://docs.magnific.com — used to pull themed stock photos for the
# generated demo sites instead of placeholder images. Test a search on
# /admin/settings → Demo siter before wiring into generation.
FREEPIK_API_KEY=

# Optional overrides. Default base is the Freepik gateway; the Magnific
# docs use the x-magnific-api-key header instead — set it if your key is
# a Magnific one.
# FREEPIK_BASE_URL=https://api.freepik.com
# FREEPIK_API_HEADER=x-freepik-api-key

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
# Used to generate per-lead site copy (hero + about). Default model is
# claude-haiku-4-5 — change via the `claude_model` setting row.
ANTHROPIC_API_KEY=

# ─── Brreg (no key needed — public API) ──────────────────────────────────────
# Documented here for transparency. No secret required.
# https://data.brreg.no/enhetsregisteret/api/docs/index.html

# ─── Supabase ────────────────────────────────────────────────────────────────
# Auto-injected by Vercel's Supabase integration on deploy.
# For local dev, copy this file to .env.local and paste your project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Inngest (background jobs) ───────────────────────────────────────────────
# Required in production. Locally, the Inngest dev server (`npx inngest-cli dev`)
# does not need these.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for absolute URLs (auth callbacks, etc.). Vercel sets this automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Brreg (no key needed — public API) ──────────────────────────────────────
# Documented here for transparency. No secret required.
# https://data.brreg.no/enhetsregisteret/api/docs/index.html

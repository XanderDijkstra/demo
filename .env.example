# Vekst-Systemet — runtime configuration on Cloudflare Workers.
#
# Plain vars live in wrangler.jsonc ("vars"): APP_URL, ACCESS_TEAM_DOMAIN,
# ACCESS_AUD, ADMIN_EMAILS. Secrets below are set once with
#   npx wrangler secret put <NAME>
# and never committed. For `next dev`, copy what you need into .dev.vars.

# Cron auth: custom-worker.js sends it as "Authorization: Bearer …" to /api/cron/*.
CRON_SECRET=

# Resend: outbound email + inbound replies + delivery events.
# Webhook (one URL for everything): https://demo.vekst-systemet.no/api/webhooks/resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# HMAC key for unsubscribe links. Old links signed with RESEND_WEBHOOK_SECRET keep working.
UNSUBSCRIBE_SECRET=

# Claude: demo-site copy. Model is the `claude_model` setting (default claude-haiku-4-5).
ANTHROPIC_API_KEY=

# Optional integrations — leave unset to disable.
ONE1881_API_KEY=        # 1881 contact enrichment (/admin/queue)
FREEPIK_API_KEY=        # stock-photo test search (/admin/settings)
TELEGRAM_BOT_TOKEN=     # ping when a lead replies
TELEGRAM_CHAT_ID=

# Local dev only (.dev.vars): skips the Cloudflare Access check under `next dev`.
ADMIN_DEV_EMAIL=
